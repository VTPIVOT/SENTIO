/ {
    fstab {
        compatible = "zephyr,fstab";

        lfs_storage: lfs_storage {
            compatible = "zephyr,fstab,littlefs";

            partition = <&storage_partition>;
            mount-point = "/lfs";

            automount;

            read-size = <16>;
            prog-size = <16>;
            cache-size = <64>;
            lookahead-size = <32>;
            block-cycles = <512>;
        };
    };
};

&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
};

