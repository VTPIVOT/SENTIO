#include <zephyr/dt-bindings/i2c/i2c.h>

/* XIAO header: D4/SDA = P0.04, D5/SCL = P0.05.
 * The board supplies i2c1 pinctrl; no custom sensor driver is needed.
 */
&i2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    maxm86161: maxm86161@62 {
        reg = <0x62>;
        status = "okay";
    };
};
