&qspi {
    status = "okay";

    external_flash: flash@0 {
        compatible = "nordic,qspi-nor";
        reg = <0>;
        size = <0x200000>; /* 2 MB */

        partitions {
            compatible = "fixed-partitions";
            #address-cells = <1>;
            #size-cells = <1>;

            storage_partition: partition@0 {
                label = "storage";
                reg = <0x00000000 0x00200000>; /* full 2 MB */
            };
        };
    };
};
